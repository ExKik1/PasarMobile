# ============================================================
#  Contoh konfigurasi PasarMobile. Salin file ini menjadi .env
#  lalu isi nilainya:  cp .env.example .env
#  File .env TIDAK boleh di-commit (sudah masuk .gitignore).
# ============================================================

# ---------- KASUS 1: Pembayaran (REST API) ----------
# mode: "mock" (bank lokal, tanpa kredensial) atau "midtrans" (gateway nyata)
PAYMENT_MODE=mock
API_PORT=4002
BANK_PORT=4001
# Kredensial Midtrans (ambil di dashboard.midtrans.com -> Settings -> Access Keys)
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false

# ---------- KASUS 2: Laporan batch ----------
# driver: "sqlite" (file lokal, default) atau "postgres" (server nyata)
DB_DRIVER=sqlite
PGHOST=localhost
PGPORT=5432
PGDATABASE=pasarmobile
PGUSER=postgres
PGPASSWORD=postgres

# ---------- KASUS 3: Message broker ----------
# driver: "memory" (broker lokal bawaan) atau "rabbitmq" (server nyata)
BROKER_DRIVER=memory
RABBITMQ_URL=amqp://guest:guest@localhost:5672
COURIER_QUEUE=courier.status
CONSUMER_PREFETCH=5
