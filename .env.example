# ============================================================
#  Contoh konfigurasi PasarMobile (opsional).
#  Salin menjadi .env bila ingin mengubah port:  cp .env.example .env
#  Semua punya nilai default, jadi proyek tetap jalan TANPA file .env.
# ============================================================

# KASUS 1 - port server
API_PORT=4002
BANK_PORT=4001

# KASUS 3 - pengaturan broker lokal
COURIER_QUEUE=courier.status
CONSUMER_PREFETCH=5

# BAGIAN C - port API stock & shipment
STORE_API_PORT=4003
