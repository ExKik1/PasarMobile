{
  "name": "pasarmobile-integration-demo",
  "version": "1.0.0",
  "description": "Implementasi 3 metode integrasi sistem untuk studi kasus PasarMobile: REST API (synchronous), File + Database Integration (batch), dan Message Broker (asynchronous). Mode lokal sederhana, tanpa dependency eksternal.",
  "private": true,
  "scripts": {
    "kasus1": "node src/kasus1-rest-api/demo.js",
    "kasus1:gateway": "node src/kasus1-rest-api/bank-gateway.js",
    "kasus1:api": "node src/kasus1-rest-api/payment-api.js",
    "kasus2": "node --no-warnings src/kasus2-batch-report/generate-report.js",
    "kasus2:seed": "node --no-warnings src/kasus2-batch-report/seed-database.js",
    "kasus3": "node src/kasus3-message-broker/demo.js",
    "bagianC": "node src/bagian-c-rest-api/stock-shipment-api.js",
    "demo:all": "node --no-warnings scripts/run-all.js",
    "test": "node --test --no-warnings \"test/*.test.js\""
  },
  "engines": {
    "node": ">=20.12"
  },
  "license": "MIT"
}
